---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.pubDate);
---

<BaseLayout
  title={`${post.data.title} | Khoirul Anam`}
  description={post.data.description}
  article={true}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
>
  <article class="max-w-3xl mx-auto space-y-8">
    <!-- Breadcrumb / Back Navigation -->
    <div class="font-mono text-xs text-[#9e958a] flex items-center justify-between pb-4 border-b border-[#2e2e42]">
      <a
        href="/blog"
        class="inline-flex items-center space-x-1.5 text-[#7daea3] hover:text-[#f29e82] transition-colors"
      >
        <span>&larr;</span>
        <span>cd .. / back to blog</span>
      </a>
      <span class="text-[#5c554e]">MARKDOWN</span>
    </div>

    <!-- Article Header -->
    <header class="space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#9e958a]">
        <span class="text-[#f29e82]">&gt;</span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>By {post.data.author}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#ece2d0] leading-tight">
        {post.data.title}
      </h1>

      <p class="font-serif italic text-base sm:text-lg text-[#9e958a] leading-relaxed">
        {post.data.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-2">
        {post.data.tags.map((tag) => (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#9e958a]">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Article Body with Serif Body & Monospace Accents -->
    <div class="prose prose-invert max-w-none font-serif text-[#d6cdbe] leading-relaxed space-y-6 pt-4 border-t border-[#2e2e42]/60">
      <Content />
    </div>

    <!-- Post-article Terminal Box -->
    <div class="mt-12 p-6 bg-[#1e1e2b] border border-[#2e2e42] rounded-lg font-mono text-xs space-y-3">
      <div class="flex items-center justify-between text-[#9e958a] pb-2 border-b border-[#2e2e42]">
        <span class="text-[#e78a4e] font-bold">// AUTHOR</span>
        <span>KHOIRUL ANAM</span>
      </div>
      <p class="text-[#9e958a] leading-relaxed font-sans">
        Khoirul Anam is an Infrastructure Engineer and Backend Developer specializing in Void Linux, high-availability Proxmox virtualization, mirrored ZFS pools, and enterprise Laravel development.
      </p>
      <div class="pt-2 flex items-center justify-between text-[#7daea3]">
        <a href="https://linkedin.com/in/sangpencerah/" target="_blank" rel="noopener noreferrer" class="hover:text-[#f29e82] transition-colors">
          [LinkedIn]
        </a>
        <a href="https://github.com/khoirulanammyid" target="_blank" rel="noopener noreferrer" class="hover:text-[#f29e82] transition-colors">
          [GitHub]
        </a>
        <a href="/#contact" class="hover:text-[#f29e82] transition-colors">
          [Contact]
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
