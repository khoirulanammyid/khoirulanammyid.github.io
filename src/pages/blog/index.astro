---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();
---

<BaseLayout
  title="Technical Notes & Log | Khoirul Anam"
  description="Technical writings and architectural deep dives on Void Linux, Proxmox virtualization, ZFS storage, container optimization, and backend systems."
>
  <div class="space-y-8">
    <!-- Breadcrumb Header -->
    <div class="font-mono text-xs text-[#9e958a] pb-4 border-b border-[#2e2e42]">
      <div class="flex items-center space-x-2">
        <a href="/" class="hover:text-[#f29e82] transition-colors">~</a>
        <span>/</span>
        <span class="text-[#f29e82]">blog</span>
        <span>/</span>
        <span class="text-[#7daea3]">index.log</span>
      </div>
    </div>

    <!-- Title & Intro -->
    <div class="space-y-3">
      <div class="text-xs uppercase tracking-widest text-[#e78a4e] font-mono">
        // NOTES &amp; FIELD LOGS
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#ece2d0]">
        Engineering Notes
      </h1>
      <p class="text-sm sm:text-base text-[#9e958a] font-sans max-w-2xl leading-relaxed">
        Deep dives into production Linux environments, bare-metal hypervisors, reproducible systems, and low-overhead application runtimes.
      </p>
    </div>

    <!-- Tag Cloud Filter -->
    {allTags.length > 0 && (
      <div class="bg-[#1e1e2b] border border-[#2e2e42] p-3 rounded flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="text-[#5c554e] uppercase">// TAGS:</span>
        {allTags.map((tag) => (
          <span class="px-2 py-0.5 rounded bg-[#16161f] border border-[#2e2e42] text-[#9e958a]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Posts Feed -->
    <div class="space-y-5">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="p-8 text-center border border-dashed border-[#2e2e42] rounded font-mono text-xs text-[#9e958a]">
        No articles published yet. Check back soon.
      </div>
    )}
  </div>
</BaseLayout>
