---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();
---

<BaseLayout
  title="Technical Log & Engineering Notes | Khoirul Anam"
  description="Technical writings and architectural deep dives on Linux kernels, Proxmox virtualization, ZFS storage, container optimization, and backend systems."
>
  <div class="space-y-8">
    <!-- Breadcrumb & Terminal Prompt Header -->
    <div class="font-mono text-xs text-[#8b949e] pb-4 border-b border-[#232b3b]">
      <div class="flex items-center space-x-2">
        <a href="/" class="hover:text-[#e5983b] transition-colors">~</a>
        <span>/</span>
        <span class="text-[#e5983b]">blog</span>
        <span>/</span>
        <span class="text-[#38bdf8]">index.log</span>
      </div>
    </div>

    <!-- Title & Intro -->
    <div class="space-y-3">
      <div class="text-xs uppercase tracking-widest text-[#e5983b] font-mono">
        // LOG_ENTRIES &amp; SYSTEMS_FIELD_NOTES
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#e6edf3]">
        Engineering Notes &amp; Insights
      </h1>
      <p class="text-sm sm:text-base text-[#8b949e] font-sans max-w-2xl leading-relaxed">
        Deep dives into production Linux environments, bare-metal hypervisors, reproducible OS distributions, and low-overhead application runtimes.
      </p>
    </div>

    <!-- Tag Cloud Filter -->
    {allTags.length > 0 && (
      <div class="bg-[#131720] border border-[#232b3b] p-3 rounded flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="text-[#4b5563] uppercase">// TAGS:</span>
        {allTags.map((tag) => (
          <span class="px-2 py-0.5 rounded bg-[#0c0e12] border border-[#232b3b] text-[#8b949e]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Posts Feed -->
    <div class="space-y-5">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="p-8 text-center border border-dashed border-[#232b3b] rounded font-mono text-xs text-[#8b949e]">
        No articles published yet. Check back soon.
      </div>
    )}
  </div>
</BaseLayout>
