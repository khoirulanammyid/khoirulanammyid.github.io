---
import { cvData } from '../data/cv';
---

<section id="about" class="pt-8 pb-12 sm:pb-16 border-b border-[#2e2e42]">
  <!-- 90s Vapor/Pastel subtle prompt line -->
  <div class="mb-6 font-mono text-xs text-[#9e958a] flex items-center space-x-2">
    <span class="text-[#cfa5d8] select-none">░▒▓</span>
    <span class="text-[#7daea3]">~ / void-linux</span>
    <span class="text-[#44445f]">&gt;</span>
    <span class="text-[#ece2d0]">init system</span>
  </div>

  <div class="max-w-3xl space-y-6">
    <!-- Main Headline & Title -->
    <div>
      <div class="inline-block text-xs uppercase tracking-wider text-[#e78a4e] font-mono mb-2 px-2 py-0.5 border border-[#e78a4e]/30 bg-[#e78a4e]/10 rounded">
        // INFRASTRUCTURE &amp; SYSTEMS
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#ece2d0] leading-[1.15]">
        {cvData.name}
      </h1>
      <p class="mt-3 text-lg sm:text-xl text-[#f29e82] font-serif italic">
        {cvData.title}
      </p>
    </div>

    <!-- Simple, Authentic Introduction -->
    <p class="text-sm sm:text-base text-[#9e958a] leading-relaxed font-sans">
      Hi, I'm Khoirul. I build reliable backend architectures, manage Linux servers (Void Linux, Proxmox VE, ZFS storage pools), and engineer clean web applications using Laravel and Vue.js. I value quiet infrastructure, database integrity during complex migrations, and open-source software freedom.
    </p>

    <!-- Simple Pastel Pills (Core Focus) -->
    <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
      <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#7daea3]">
        Void Linux &amp; Proxmox
      </span>
      <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#f29e82]">
        Laravel &amp; Vue.js
      </span>
      <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#8ec07c]">
        ZFS &amp; Data Integrity
      </span>
      <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#cfa5d8]">
        Open Source &amp; Systems
      </span>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-3 pt-4">
      <a
        href="#projects"
        class="px-4 py-2 text-xs font-mono font-semibold bg-[#e78a4e] text-[#16161f] rounded hover:bg-[#f29e82] transition-colors flex items-center space-x-1.5 shadow-sm"
      >
        <span>View Projects</span>
        <span>↓</span>
      </a>
      <a
        href="/blog"
        class="px-4 py-2 text-xs font-mono font-medium text-[#ece2d0] bg-[#1e1e2b] border border-[#2e2e42] hover:border-[#44445f] rounded hover:text-[#f29e82] transition-colors flex items-center space-x-1.5"
      >
        <span>Technical Notes</span>
        <span>→</span>
      </a>
      <a
        href="#contact"
        class="px-4 py-2 text-xs font-mono text-[#9e958a] hover:text-[#ece2d0] transition-colors"
      >
        [ Contact ]
      </a>
    </div>
  </div>
</section>
