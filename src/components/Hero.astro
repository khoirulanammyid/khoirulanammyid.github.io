---
import { cvData } from '../data/cv';
---

<section id="about" class="pt-6 pb-12 sm:pb-16 border-b border-[#2e2e42]">
  <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-center">
    <!-- Profile Photo with Retro 80s/90s Pastel Border Frame -->
    <div class="sm:col-span-4 lg:col-span-3 flex justify-start sm:justify-center">
      <div class="relative group">
        <!-- Subtle pastel vapor frame glow -->
        <div class="absolute -inset-0.5 bg-gradient-to-r from-[#e78a4e]/30 via-[#cfa5d8]/30 to-[#7daea3]/30 rounded-lg blur-xs opacity-75 group-hover:opacity-100 transition duration-300"></div>
        
        <div class="relative p-1.5 bg-[#1e1e2b] border border-[#44445f] rounded-lg shadow-lg">
          <img
            src="/photos/profile.webp"
            alt="Khoirul Anam"
            width="800"
            height="1068"
            loading="eager"
            decoding="async"
            class="w-36 sm:w-44 lg:w-48 h-auto object-cover rounded filter contrast-[1.02] brightness-[0.98]"
          />
          <div class="mt-1.5 pt-1 border-t border-[#2e2e42] flex items-center justify-between text-[10px] font-mono text-[#9e958a]">
            <span>[avatar.webp]</span>
            <span class="text-[#8ec07c]">online</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Headline & Description -->
    <div class="sm:col-span-8 lg:col-span-9 space-y-5">
      <div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#ece2d0] leading-[1.15]">
          {cvData.name}
        </h1>
        <p class="mt-2 text-lg sm:text-xl text-[#f29e82] font-serif italic">
          {cvData.title}
        </p>
      </div>

      <!-- Simple, Personal Introduction -->
      <p class="text-sm sm:text-base text-[#9e958a] leading-relaxed font-sans">
        Hi, I'm Khoirul. I build reliable backend architectures, manage Linux servers (Void Linux, Proxmox VE, ZFS storage pools), and engineer clean web applications using Laravel and Vue.js. Having formerly daily-driven Arch Linux for years, I now daily drive Void Linux. I value quiet infrastructure, database integrity during complex migrations, and open-source software freedom.
      </p>

      <!-- Simple Pastel Focus Pills -->
      <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
        <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#7daea3]">
          Void Linux &amp; Proxmox
        </span>
        <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#f29e82]">
          Laravel &amp; Vue.js
        </span>
        <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#8ec07c]">
          ZFS &amp; Data Integrity
        </span>
        <span class="px-2.5 py-1 rounded bg-[#1e1e2b] border border-[#2e2e42] text-[#cfa5d8]">
          Open Source Systems
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#projects"
          class="px-4 py-2 text-xs font-mono font-semibold bg-[#e78a4e] text-[#16161f] rounded hover:bg-[#f29e82] transition-colors flex items-center space-x-1.5 shadow-sm"
        >
          <span>View Projects</span>
          <span>↓</span>
        </a>
        <a
          href="/blog"
          class="px-4 py-2 text-xs font-mono font-medium text-[#ece2d0] bg-[#1e1e2b] border border-[#2e2e42] hover:border-[#44445f] rounded hover:text-[#f29e82] transition-colors flex items-center space-x-1.5"
        >
          <span>Technical Notes</span>
          <span>→</span>
        </a>
        <a
          href="#contact"
          class="px-4 py-2 text-xs font-mono text-[#9e958a] hover:text-[#ece2d0] transition-colors"
        >
          [ Contact ]
        </a>
      </div>
    </div>
  </div>
</section>
