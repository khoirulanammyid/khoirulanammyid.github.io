---
import { cvData } from '../data/cv';
---

<section id="experience" class="py-12 border-b border-[#232b3b]">
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-xs font-mono text-[#e5983b] uppercase tracking-wider mb-1">
      <span>// 02. TIMELINE_HISTORY</span>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#e6edf3]">
      Work &amp; Engineering Experience
    </h2>
    <p class="font-mono text-xs text-[#8b949e] mt-2">
      Production roles spanning systems administration, high-availability virtualization, and enterprise backend engineering.
    </p>
  </div>

  <!-- Work Experience List -->
  <div class="space-y-6">
    {cvData.workExperience.map((exp, idx) => (
      <div class="group bg-[#131720]/80 border border-[#232b3b] hover:border-[#37435c] rounded p-5 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-[#232b3b]/60 gap-1 sm:gap-0">
          <div>
            <span class="font-mono text-[11px] text-[#e5983b] uppercase tracking-wide">
              [{exp.type === 'project' ? 'PROJECT_CONTRACT' : 'ENTERPRISE_ROLE'}]
            </span>
            <h3 class="font-serif text-xl font-bold text-[#e6edf3] group-hover:text-[#e5983b] transition-colors">
              {exp.role}
            </h3>
            <div class="font-mono text-xs text-[#38bdf8] mt-0.5">
              @ {exp.company} {exp.location && <span class="text-[#8b949e]">· {exp.location}</span>}
            </div>
          </div>
          <div class="font-mono text-xs text-[#8b949e] whitespace-nowrap self-start sm:self-auto bg-[#0c0e12] px-2.5 py-1 rounded border border-[#232b3b]">
            {exp.period}
          </div>
        </div>

        {exp.highlight && (
          <div class="mt-3 text-xs font-mono text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20 px-2.5 py-1.5 rounded">
            <span class="font-bold">IMPACT:</span> {exp.highlight}
          </div>
        )}

        <ul class="mt-4 space-y-2 text-xs sm:text-sm text-[#8b949e] font-sans">
          {exp.description.map((item) => (
            <li class="flex items-start space-x-2">
              <span class="font-mono text-[#e5983b] font-bold mt-0.5 select-none">&gt;</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Organization & Volunteer Experience -->
  <div class="mt-12 pt-8 border-t border-[#232b3b]/60">
    <div class="mb-6">
      <div class="flex items-center space-x-2 text-xs font-mono text-[#38bdf8] uppercase tracking-wider mb-1">
        <span>// COMMUNITY &amp; OPEN SOURCE LEADERSHIP</span>
      </div>
      <h3 class="font-serif text-2xl font-bold text-[#e6edf3]">
        Open Source &amp; Community Contributions
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {cvData.volunteerExperience.map((vol) => (
        <div class="bg-[#131720]/60 border border-[#232b3b] hover:border-[#37435c] rounded p-4 space-y-3">
          <div class="flex items-start justify-between">
            <div>
              <span class="font-mono text-[10px] text-[#38bdf8] uppercase">[COMMUNITY_CORE]</span>
              <h4 class="font-serif text-lg font-bold text-[#e6edf3]">{vol.role}</h4>
              <div class="font-mono text-xs text-[#8b949e]">{vol.company}</div>
            </div>
            <span class="font-mono text-[11px] text-[#4b5563] bg-[#0c0e12] px-2 py-0.5 rounded border border-[#232b3b]">
              {vol.period}
            </span>
          </div>

          {vol.highlight && (
            <div class="text-[11px] font-mono text-[#10b981] bg-[#10b981]/5 border border-[#10b981]/20 px-2 py-1 rounded">
              {vol.highlight}
            </div>
          )}

          <ul class="space-y-1.5 text-xs text-[#8b949e] font-sans">
            {vol.description.map((item) => (
              <li class="flex items-start space-x-1.5">
                <span class="font-mono text-[#38bdf8] font-bold select-none">&gt;</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
