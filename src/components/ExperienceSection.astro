---
import { cvData } from '../data/cv';
---

<section id="experience" class="py-12 border-b border-[#2e2e42]">
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-xs font-mono text-[#e78a4e] uppercase tracking-wider mb-1">
      <span>// TIMELINE &amp; LOG</span>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#ece2d0]">
      Experience &amp; Roles
    </h2>
    <p class="font-mono text-xs text-[#9e958a] mt-2">
      Systems administration, high-availability virtualization, and enterprise backend projects.
    </p>
  </div>

  <!-- Work Experience List -->
  <div class="space-y-6">
    {cvData.workExperience.map((exp) => (
      <div class="group bg-[#1e1e2b]/80 border border-[#2e2e42] hover:border-[#44445f] rounded p-5 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-[#2e2e42]/60 gap-1 sm:gap-0">
          <div>
            <span class="font-mono text-[11px] text-[#f29e82] uppercase tracking-wide">
              [{exp.type === 'project' ? 'PROJECT_ROLE' : 'ENTERPRISE'}]
            </span>
            <h3 class="font-serif text-xl font-bold text-[#ece2d0] group-hover:text-[#f29e82] transition-colors">
              {exp.role}
            </h3>
            <div class="font-mono text-xs text-[#7daea3] mt-0.5">
              @ {exp.company} {exp.location && <span class="text-[#9e958a]">· {exp.location}</span>}
            </div>
          </div>
          <div class="font-mono text-xs text-[#9e958a] whitespace-nowrap self-start sm:self-auto bg-[#16161f] px-2.5 py-1 rounded border border-[#2e2e42]">
            {exp.period}
          </div>
        </div>

        {exp.highlight && (
          <div class="mt-3 text-xs font-mono text-[#8ec07c] bg-[#8ec07c]/10 border border-[#8ec07c]/20 px-2.5 py-1.5 rounded">
            <span class="font-bold">NOTE:</span> {exp.highlight}
          </div>
        )}

        <ul class="mt-4 space-y-2 text-xs sm:text-sm text-[#9e958a] font-sans">
          {exp.description.map((item) => (
            <li class="flex items-start space-x-2">
              <span class="font-mono text-[#e78a4e] font-bold mt-0.5 select-none">&gt;</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Organization & Volunteer Experience -->
  <div class="mt-12 pt-8 border-t border-[#2e2e42]/60">
    <div class="mb-6">
      <div class="flex items-center space-x-2 text-xs font-mono text-[#cfa5d8] uppercase tracking-wider mb-1">
        <span>// COMMUNITY &amp; OPEN SOURCE</span>
      </div>
      <h3 class="font-serif text-2xl font-bold text-[#ece2d0]">
        Open Source Contributions
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {cvData.volunteerExperience.map((vol) => (
        <div class="bg-[#1e1e2b]/60 border border-[#2e2e42] hover:border-[#44445f] rounded p-4 space-y-3">
          <div class="flex items-start justify-between">
            <div>
              <span class="font-mono text-[10px] text-[#cfa5d8] uppercase">[COMMUNITY]</span>
              <h4 class="font-serif text-lg font-bold text-[#ece2d0]">{vol.role}</h4>
              <div class="font-mono text-xs text-[#9e958a]">{vol.company}</div>
            </div>
            <span class="font-mono text-[11px] text-[#5c554e] bg-[#16161f] px-2 py-0.5 rounded border border-[#2e2e42]">
              {vol.period}
            </span>
          </div>

          {vol.highlight && (
            <div class="text-[11px] font-mono text-[#8ec07c] bg-[#8ec07c]/5 border border-[#8ec07c]/20 px-2 py-1 rounded">
              {vol.highlight}
            </div>
          )}

          <ul class="space-y-1.5 text-xs text-[#9e958a] font-sans">
            {vol.description.map((item) => (
              <li class="flex items-start space-x-1.5">
                <span class="font-mono text-[#7daea3] font-bold select-none">&gt;</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
