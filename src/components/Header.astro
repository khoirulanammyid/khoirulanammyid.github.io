---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "about", href: "/#about", sectionId: "about" },
  { label: "experience", href: "/#experience", sectionId: "experience" },
  { label: "projects", href: "/#projects", sectionId: "projects" },
  { label: "skills", href: "/#skills", sectionId: "skills" },
  { label: "contact", href: "/#contact", sectionId: "contact" },
  { label: "blog", href: "/blog", sectionId: "blog" },
];
---

<header class="sticky top-0 z-40 bg-[#16161f]/90 backdrop-blur-md border-b border-[#2e2e42] transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Simple & Clean Brand Identifier -->
      <a href="/" class="group flex items-center space-x-1.5 text-sm font-mono font-medium text-[#ece2d0] hover:text-[#f29e82] transition-colors">
        <span class="text-[#e78a4e] select-none">&gt;</span>
        <span class="tracking-tight">khoirul anam</span>
        <span class="text-[#7daea3] select-none">_</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-xs" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isInitialActive = item.sectionId === 'blog'
            ? currentPath.startsWith('/blog')
            : (currentPath === '/' && item.sectionId === 'about');
          return (
            <a
              href={item.href}
              data-nav-section={item.sectionId}
              class={`nav-link px-2.5 py-1 rounded transition-all duration-150 font-mono border ${
                isInitialActive
                  ? "active-nav text-[#f29e82] bg-[#262637] border-[#44445f]"
                  : "inactive-nav text-[#9e958a] hover:text-[#ece2d0] hover:bg-[#1e1e2b] border-transparent"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 text-[#9e958a] hover:text-[#ece2d0] hover:bg-[#1e1e2b] rounded border border-[#2e2e42]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <svg id="menu-icon-bars" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-[#2e2e42] py-3 space-y-1">
      {navItems.map((item) => {
        const isInitialActive = item.sectionId === 'blog'
          ? currentPath.startsWith('/blog')
          : (currentPath === '/' && item.sectionId === 'about');
        return (
          <a
            href={item.href}
            data-nav-section={item.sectionId}
            class={`mobile-nav-link block px-3 py-2 text-sm rounded font-mono border ${
              isInitialActive
                ? "active-nav text-[#f29e82] bg-[#262637] border-[#44445f]"
                : "inactive-nav text-[#9e958a] hover:text-[#ece2d0] hover:bg-[#1e1e2b] border-transparent"
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </div>
</header>

<script>
  function setupNav() {
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    // Mobile toggle
    if (mobileBtn && mobileMenu) {
      mobileBtn.onclick = () => {
        const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
        mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        iconBars?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      };
    }

    function applyActiveStyles(activeSectionId: string) {
      allNavLinks.forEach(link => {
        const matches = link.dataset.navSection === activeSectionId;
        if (matches) {
          link.classList.add('text-[#f29e82]', 'bg-[#262637]', 'border-[#44445f]');
          link.classList.remove('text-[#9e958a]', 'border-transparent');
        } else {
          link.classList.remove('text-[#f29e82]', 'bg-[#262637]', 'border-[#44445f]');
          link.classList.add('text-[#9e958a]', 'border-transparent');
        }
      });
    }

    if (!isHomePage) {
      if (window.location.pathname.startsWith('/blog')) {
        applyActiveStyles('blog');
      }
      return;
    }

    // Single-page ScrollSpy on homepage
    const sections: HTMLElement[] = [];
    const sectionIds = ['about', 'experience', 'projects', 'skills', 'contact'];

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) sections.push(el);
    });

    function updateActiveOnScroll() {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;

      // If near the bottom of the page, activate contact
      if (scrollY + windowHeight >= documentHeight - 60) {
        applyActiveStyles('contact');
        return;
      }

      let currentId = 'about';
      const offset = 140; // Navbar height + margin

      for (const section of sections) {
        const sectionTop = section.offsetTop - offset;
        const sectionHeight = section.offsetHeight;
        if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
          currentId = section.id;
          break;
        } else if (scrollY >= sectionTop) {
          currentId = section.id;
        }
      }

      applyActiveStyles(currentId);
    }

    window.addEventListener('scroll', updateActiveOnScroll, { passive: true });
    updateActiveOnScroll();

    // Smooth click handler
    allNavLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.dataset.navSection;
        if (targetId && targetId !== 'blog') {
          const targetEl = document.getElementById(targetId);
          if (targetEl && isHomePage) {
            e.preventDefault();
            history.pushState(null, '', `#${targetId}`);
            const navOffset = 70;
            const elementPosition = targetEl.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - navOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });

            applyActiveStyles(targetId);

            // Close mobile menu if open
            if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
              mobileMenu.classList.add('hidden');
              mobileBtn?.setAttribute('aria-expanded', 'false');
              iconBars?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
            }
          }
        }
      });
    });
  }

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
