---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "about", href: "/#about" },
  { label: "experience", href: "/#experience" },
  { label: "projects", href: "/#projects" },
  { label: "skills", href: "/#skills" },
  { label: "blog", href: "/blog" },
  { label: "contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-40 bg-[#16161f]/90 backdrop-blur-md border-b border-[#2e2e42] transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Simple & Clean Brand Identifier -->
      <a href="/" class="group flex items-center space-x-1.5 text-sm font-mono font-medium text-[#ece2d0] hover:text-[#f29e82] transition-colors">
        <span class="text-[#e78a4e] select-none">&gt;</span>
        <span class="tracking-tight">khoirul anam</span>
        <span class="text-[#7daea3] select-none">_</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-3 text-xs" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = item.href === '/blog' ? currentPath.startsWith('/blog') : (currentPath === '/' && item.href === '/#about');
          return (
            <a
              href={item.href}
              class={`px-2.5 py-1 rounded transition-colors duration-150 font-mono ${
                isActive
                  ? "text-[#f29e82] bg-[#262637] border border-[#44445f]"
                  : "text-[#9e958a] hover:text-[#ece2d0] hover:bg-[#1e1e2b]"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 text-[#9e958a] hover:text-[#ece2d0] hover:bg-[#1e1e2b] rounded border border-[#2e2e42]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <svg id="menu-icon-bars" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-[#2e2e42] py-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link block px-3 py-2 text-sm text-[#9e958a] hover:text-[#f29e82] hover:bg-[#1e1e2b] rounded font-mono"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-2 border-t border-[#2e2e42]/60 px-3 flex items-center justify-between text-xs text-[#9e958a]">
        <span>SYS: VOID LINUX</span>
        <span class="text-[#8ec07c]">ONLINE</span>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconBars?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconBars?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
