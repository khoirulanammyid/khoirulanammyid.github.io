---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "01 // overview", href: "/#about" },
  { label: "02 // experience", href: "/#experience" },
  { label: "03 // projects", href: "/#projects" },
  { label: "04 // skills", href: "/#skills" },
  { label: "05 // blog", href: "/blog" },
  { label: "06 // contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-40 bg-[#0c0e12]/90 backdrop-blur-md border-b border-[#232b3b] transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Logo / Terminal Prompt -->
      <a href="/" class="group flex items-center space-x-2 text-sm text-[#e6edf3] font-mono hover:text-[#e5983b] transition-colors">
        <span class="text-[#e5983b] font-bold">&gt;</span>
        <span class="tracking-wide">khoirul@srv</span>
        <span class="text-[#8b949e]">:</span>
        <span class="text-[#38bdf8]">~</span>
        <span class="text-[#8b949e]">$</span>
        <span class="w-2 h-4 bg-[#e5983b] inline-block animate-pulse ml-0.5"></span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-3 text-xs" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = item.href === '/blog' ? currentPath.startsWith('/blog') : (currentPath === '/' && item.href === '/#about');
          return (
            <a
              href={item.href}
              class={`px-2.5 py-1 rounded transition-colors duration-150 font-mono tracking-tight ${
                isActive
                  ? "text-[#e5983b] bg-[#1a202c] border border-[#37435c]"
                  : "text-[#8b949e] hover:text-[#e6edf3] hover:bg-[#131720]"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- System Status Indicator (Retro Tag) -->
      <div class="hidden sm:flex items-center space-x-2 text-[11px] text-[#8b949e] border border-[#232b3b] px-2.5 py-0.5 rounded bg-[#131720]/60">
        <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
        <span class="text-[#10b981]">ready</span>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 text-[#8b949e] hover:text-[#e6edf3] hover:bg-[#131720] rounded border border-[#232b3b]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <svg id="menu-icon-bars" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-[#232b3b] py-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link block px-3 py-2 text-sm text-[#8b949e] hover:text-[#e5983b] hover:bg-[#131720] rounded font-mono"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-2 border-t border-[#232b3b]/60 px-3 flex items-center justify-between text-xs text-[#8b949e]">
        <span>STATUS: ACTIVE</span>
        <span class="text-[#10b981]">SYS: ARCH 6.12</span>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconBars?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconBars?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  // Setup on initial load and view transition page loads
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
