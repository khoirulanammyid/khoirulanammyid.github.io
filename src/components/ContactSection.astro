---
import { cvData } from '../data/cv';
---

<section id="contact" class="py-12">
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-xs font-mono text-[#e5983b] uppercase tracking-wider mb-1">
      <span>// 06. TRANSMISSION_CHANNEL</span>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#e6edf3]">
      Initiate Communication
    </h2>
    <p class="font-mono text-xs text-[#8b949e] mt-2">
      Open for infrastructure consulting, system architecture contracts, high-availability virtualization, and backend engineering opportunities.
    </p>
  </div>

  <div class="bg-[#131720] border border-[#232b3b] rounded-lg p-6 sm:p-8 space-y-6">
    <!-- Terminal header -->
    <div class="font-mono text-xs text-[#8b949e] pb-3 border-b border-[#232b3b] flex items-center justify-between">
      <span class="text-[#10b981] flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-[#10b981] inline-block animate-pulse"></span>
        <span>CHANNEL_OPEN: READY FOR CONNECTION</span>
      </span>
      <span class="text-[#4b5563]">PORT: 443 / TLS 1.3</span>
    </div>

    <!-- Communication Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Email -->
      <a
        href={`mailto:${cvData.contact.email}`}
        class="group p-4 bg-[#0c0e12] border border-[#232b3b] hover:border-[#e5983b] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#e5983b] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#8b949e] uppercase">Direct Email</div>
          <div class="font-mono text-xs sm:text-sm text-[#e6edf3] group-hover:text-[#e5983b] transition-colors break-all">
            {cvData.contact.email}
          </div>
        </div>
      </a>

      <!-- WhatsApp / Phone -->
      <a
        href={cvData.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#0c0e12] border border-[#232b3b] hover:border-[#10b981] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#10b981] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#8b949e] uppercase">WhatsApp / Tel</div>
          <div class="font-mono text-xs sm:text-sm text-[#e6edf3] group-hover:text-[#10b981] transition-colors">
            {cvData.contact.phone}
          </div>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href={cvData.contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#0c0e12] border border-[#232b3b] hover:border-[#38bdf8] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#38bdf8] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#8b949e] uppercase">LinkedIn Network</div>
          <div class="font-mono text-xs sm:text-sm text-[#e6edf3] group-hover:text-[#38bdf8] transition-colors">
            linkedin.com/in/sangpencerah
          </div>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href={cvData.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#0c0e12] border border-[#232b3b] hover:border-[#e6edf3] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#e6edf3] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#8b949e] uppercase">Source Repositories</div>
          <div class="font-mono text-xs sm:text-sm text-[#e6edf3] group-hover:text-[#e5983b] transition-colors">
            github.com/akunnyaanam
          </div>
        </div>
      </a>
    </div>

    <!-- Geographic Coordinates & Response Policy -->
    <div class="pt-4 border-t border-[#232b3b] flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-[#8b949e] gap-2">
      <div>
        <span class="text-[#4b5563]">LOCATION:</span> {cvData.location}
      </div>
      <div>
        <span class="text-[#4b5563]">RESPONSE_SLA:</span> &lt; 24 business hours
      </div>
    </div>
  </div>
</section>
