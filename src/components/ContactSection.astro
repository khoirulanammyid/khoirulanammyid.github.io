---
import { cvData } from '../data/cv';
---

<section id="contact" class="py-12">
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-xs font-mono text-[#e78a4e] uppercase tracking-wider mb-1">
      <span>// TRANSMISSION</span>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#ece2d0]">
      Get in Touch
    </h2>
    <p class="font-mono text-xs text-[#9e958a] mt-2">
      Open for backend engineering, Linux systems administration, virtualization setups, and infrastructure consultations.
    </p>
  </div>

  <div class="bg-[#1e1e2b] border border-[#2e2e42] rounded-lg p-6 sm:p-8 space-y-6">
    <div class="font-mono text-xs text-[#9e958a] pb-3 border-b border-[#2e2e42] flex items-center justify-between">
      <span class="text-[#8ec07c] flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-[#8ec07c] inline-block"></span>
        <span>CHANNEL OPEN</span>
      </span>
      <span class="text-[#5c554e]">// SECURE CHANNELS</span>
    </div>

    <!-- Communication Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Email -->
      <a
        href={`mailto:${cvData.contact.email}`}
        class="group p-4 bg-[#16161f] border border-[#2e2e42] hover:border-[#f29e82] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#f29e82] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#9e958a] uppercase">Email</div>
          <div class="font-mono text-xs sm:text-sm text-[#ece2d0] group-hover:text-[#f29e82] transition-colors break-all">
            {cvData.contact.email}
          </div>
        </div>
      </a>

      <!-- WhatsApp / Phone -->
      <a
        href={cvData.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#16161f] border border-[#2e2e42] hover:border-[#8ec07c] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#8ec07c] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#9e958a] uppercase">WhatsApp / Tel</div>
          <div class="font-mono text-xs sm:text-sm text-[#ece2d0] group-hover:text-[#8ec07c] transition-colors">
            {cvData.contact.phone}
          </div>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href={cvData.contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#16161f] border border-[#2e2e42] hover:border-[#cfa5d8] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#cfa5d8] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#9e958a] uppercase">LinkedIn</div>
          <div class="font-mono text-xs sm:text-sm text-[#ece2d0] group-hover:text-[#cfa5d8] transition-colors">
            linkedin.com/in/khoirulanammyid
          </div>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href={cvData.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-[#16161f] border border-[#2e2e42] hover:border-[#7daea3] rounded transition-colors flex items-start space-x-3"
      >
        <span class="text-base text-[#7daea3] font-mono mt-0.5">&gt;</span>
        <div class="space-y-1">
          <div class="font-mono text-[11px] text-[#9e958a] uppercase">GitHub</div>
          <div class="font-mono text-xs sm:text-sm text-[#ece2d0] group-hover:text-[#7daea3] transition-colors">
            github.com/khoirulanammyid
          </div>
        </div>
      </a>
    </div>

    <!-- Geographic Coordinates -->
    <div class="pt-4 border-t border-[#2e2e42] flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-[#9e958a] gap-2">
      <div>
        <span class="text-[#5c554e]">LOCATION:</span> {cvData.location}
      </div>
      <div>
        <span class="text-[#5c554e]">RESPONSE:</span> &lt; 24h
      </div>
    </div>
  </div>
</section>
