---
import { cvData } from '../data/cv';

const currentYear = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[#2e2e42] bg-[#16161f] relative z-10 text-xs text-[#9e958a]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Col 1: Identity & Coordinates -->
      <div class="space-y-2">
        <div class="font-mono text-sm text-[#ece2d0] font-bold flex items-center space-x-1.5">
          <span class="text-[#e78a4e]">&gt;</span>
          <span>{cvData.name}</span>
        </div>
        <p class="text-xs text-[#9e958a] leading-relaxed">
          {cvData.title}. Based in Ambarawa / Semarang, Central Java. Focused on resilient infrastructure, virtualization, and backend engineering.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-wider text-[#ece2d0] font-semibold">
          // navigation
        </div>
        <ul class="space-y-1 font-mono text-xs">
          <li><a href="/#about" class="hover:text-[#f29e82] transition-colors">~ / about</a></li>
          <li><a href="/#experience" class="hover:text-[#f29e82] transition-colors">~ / experience</a></li>
          <li><a href="/#projects" class="hover:text-[#f29e82] transition-colors">~ / projects</a></li>
          <li><a href="/#skills" class="hover:text-[#f29e82] transition-colors">~ / skills</a></li>
          <li><a href="/#contact" class="hover:text-[#f29e82] transition-colors">~ / contact</a></li>
          <li><a href="/blog" class="hover:text-[#f29e82] transition-colors">~ / blog (technical notes)</a></li>
        </ul>
      </div>

      <!-- Col 3: External Nodes -->
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-wider text-[#ece2d0] font-semibold">
          // endpoints
        </div>
        <ul class="space-y-1 font-mono text-xs">
          <li>
            <a href={cvData.contact.github} target="_blank" rel="noopener noreferrer" class="hover:text-[#f29e82] transition-colors flex items-center space-x-1">
              <span>gh:</span> <span class="underline">github.com/khoirulanammyid</span>
            </a>
          </li>
          <li>
            <a href={cvData.contact.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[#f29e82] transition-colors flex items-center space-x-1">
              <span>in:</span> <span class="underline">linkedin.com/in/sangpencerah</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${cvData.contact.email}`} class="hover:text-[#f29e82] transition-colors flex items-center space-x-1">
              <span>em:</span> <span class="underline">{cvData.contact.email}</span>
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="hover:text-[#f29e82] transition-colors flex items-center space-x-1">
              <span>map:</span> <span class="underline">sitemap-index.xml</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom baseline -->
    <div class="pt-6 border-t border-[#2e2e42]/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#5c554e] space-y-2 sm:space-y-0">
      <div>
        &copy; {currentYear} {cvData.name}. When it's work, don't touch it
      </div>
      <div class="font-mono">
        <span>LOC: IDN (GMT+7)</span>
      </div>
    </div>
  </div>
</footer>
