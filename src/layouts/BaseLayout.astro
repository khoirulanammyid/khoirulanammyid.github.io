---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title = "Khoirul Anam | Infrastructure Engineer & Backend Developer",
  description = "Infrastructure Engineer and Backend Developer specializing in Void Linux, Proxmox VE virtualization, ZFS storage, and the Laravel/Vue ecosystem.",
  image = "/photos/ims-1.png",
  article = false,
  pubDate,
  updatedDate,
  tags = []
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://khoirulanam.my.id');
const siteName = "Khoirul Anam Portfolio & Technical Log";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Khoirul Anam",
  "jobTitle": "Infrastructure Engineer & Backend Developer",
  "url": "https://khoirulanam.my.id",
  "email": "akunnyakhoirulanam@gmail.com",
  "telephone": "+6283195234531",
  "sameAs": [
    "https://linkedin.com/in/khoirulanammyid/",
    "https://github.com/khoirulanammyid",
    "https://github.com/tealinuxos"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ambarawa / Semarang",
    "addressRegion": "Central Java",
    "addressCountry": "ID"
  },
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Universitas Dian Nuswantoro"
  },
  "knowsAbout": [
    "Void Linux System Administration",
    "Proxmox VE Virtualization",
    "ZFS Storage Pools",
    "Laravel Framework",
    "Vue.js",
    "Docker Containerization",
    "Open Source Systems"
  ]
};

const articleSchema = article ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": canonicalURL.toString(),
  "datePublished": pubDate?.toISOString(),
  "dateModified": (updatedDate || pubDate)?.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Khoirul Anam",
    "url": "https://khoirulanam.my.id"
  },
  "keywords": tags.join(", ")
} : null;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth selection:bg-[#e78a4e]/30 selection:text-[#ece2d0]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#16161f" />

    <!-- Canonical & SEO -->
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Khoirul Anam" />
    <meta name="robots" content="index, follow" />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://khoirulanam.my.id')} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site || 'https://khoirulanam.my.id')} />

    <!-- Favicon (Retro Terminal Monogram SVG) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='16' fill='%2316161f'/><rect x='4' y='4' width='92' height='92' rx='12' fill='none' stroke='%23e78a4e' stroke-width='4'/><text x='18' y='65' font-family='monospace' font-weight='bold' font-size='52' fill='%23e78a4e'>&gt;_</text></svg>" />

    <!-- Preload Critical Fantasque Sans Mono Webfonts for instant rendering -->
    <link rel="preload" href="/fonts/FantasqueSansMono-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/FantasqueSansMono-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <!-- Astro SPA View Transitions -->
    <ClientRouter />
  </head>
  <body class="bg-[#16161f] text-[#ece2d0] font-mono min-h-screen flex flex-col retro-grid-bg relative antialiased selection:bg-[#e78a4e]/25 selection:text-[#ece2d0]">
    <!-- Subtle Retro CRT Scanline Overlay -->
    <div class="scanlines-overlay" aria-hidden="true"></div>

    <!-- Header Navigation -->
    <Header />

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
